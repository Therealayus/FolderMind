<Page
    x:Class="AIFolderAssistant.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <StackPanel Margin="24" Spacing="12" MaxWidth="640">
        <TextBlock Text="FolderMind AI" FontSize="26" FontWeight="Bold" />
        <TextBlock Text="Version 1.0.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock TextWrapping="Wrap" Text="FolderMind AI watches the folders you choose and suggests meaningful names based on their contents. It never renames anything without your explicit confirmation. Local analysis works fully offline; cloud AI is optional and off by default." />
        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Privacy first · User control · Local first · Explainable · Lightweight · Reliable · Native" />
    </StackPanel>
</Page>
