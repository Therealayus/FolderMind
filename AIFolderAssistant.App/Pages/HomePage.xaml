<Page
    x:Class="AIFolderAssistant.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="800">
            <TextBlock Text="Good day — your folders are looking organized."
                       FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16" MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.MonitoredCount, Mode=OneWay}" FontSize="32" FontWeight="Bold" />
                        <TextBlock Text="Monitored" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16" MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}" FontSize="32" FontWeight="Bold" />
                        <TextBlock Text="Suggestions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Recent suggestions" FontSize="16" FontWeight="SemiBold" />
            <ListView ItemsSource="{x:Bind ViewModel.Recent, Mode=OneWay}" SelectionMode="None" MaxHeight="220" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh" Click="Refresh_Click" />
                <Button Content="Analyze Folder…" Click="Analyze_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
