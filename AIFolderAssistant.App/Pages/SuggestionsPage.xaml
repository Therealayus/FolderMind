<Page
    x:Class="AIFolderAssistant.App.Pages.SuggestionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AIFolderAssistant.Core.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <StackPanel Margin="24" Spacing="12" MaxWidth="860">
        <TextBlock Text="Suggestions" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="FolderMind never renames without your explicit confirmation."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="FilterBox" SelectedIndex="0" SelectionChanged="Filter_Changed" MinWidth="140">
                <ComboBoxItem Content="Pending" />
                <ComboBoxItem Content="Accepted" />
                <ComboBoxItem Content="Ignored" />
            </ComboBox>
            <Button Content="Refresh" Click="Refresh_Click" />
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SuggestionInfo">
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel Spacing="4">
                            <TextBlock>
                                <Run Text="{x:Bind OriginalName}" />
                                <Run Text=" → " />
                                <Run Text="{x:Bind SuggestedName}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind ConfidenceBand}" FontWeight="SemiBold" />
                                <Run Text=" confidence · " />
                                <Run Text="{x:Bind Reason}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind FolderPath}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Rename Folder" Tag="{x:Bind}" Click="Rename_Click"
                                        Style="{ThemeResource AccentButtonStyle}" />
                                <Button Content="Ignore" Tag="{x:Bind}" Click="Ignore_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</Page>
