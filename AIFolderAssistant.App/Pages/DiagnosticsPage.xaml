<Page
    x:Class="AIFolderAssistant.App.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <StackPanel Margin="24" Spacing="12" MaxWidth="860">
        <TextBlock Text="Diagnostics" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh" Click="Refresh_Click" />
            <Button Content="Open logs folder" Click="Logs_Click" />
            <Button Content="Export diagnostics" Click="Export_Click" />
        </StackPanel>
        <ListView x:Name="LogList" SelectionMode="None" MaxHeight="400" />
    </StackPanel>
</Page>
