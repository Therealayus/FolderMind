<Window
    x:Class="AIFolderAssistant.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FolderMind AI">
    <NavigationView x:Name="NavView"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="home" />
            <NavigationViewItem Content="Suggestions" Tag="suggestions" />
            <NavigationViewItem Content="Monitored Folders" Tag="folders" />
            <NavigationViewItem Content="History" Tag="history" />
            <NavigationViewItem Content="Settings" Tag="settings" />
            <NavigationViewItem Content="Diagnostics" Tag="diagnostics" />
            <NavigationViewItem Content="About" Tag="about" />
        </NavigationView.MenuItems>
        <NavigationView.Header>
            <TextBlock x:Name="HeaderText" Text="FolderMind AI" FontSize="20" FontWeight="SemiBold" Margin="12,8,0,8" />
        </NavigationView.Header>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
